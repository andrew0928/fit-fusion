<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../python/fit_fusion/profile.tsv" LogicalName="profile.tsv" />
    <EmbeddedResource Include="../../python/fit_fusion/guides/*.md;../../python/fit_fusion/guides/*.txt" Exclude="../../python/fit_fusion/guides/sdk-check.*" LogicalName="guides.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
