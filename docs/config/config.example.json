{
  "version": 1,
  "timezone": "Asia/Taipei",
  "output_dir": "~/Rides/merged",
  "sources": {
    "bike_meter": {
      "kind": "fit_directory",
      "directory": "~/Rides/inbox/bike_meter"
    },
    "health_band": {
      "kind": "garmin_connect",
      "device": {"manufacturer": 1, "product": 5019},
      "cache_dir": "~/Rides/cache/garmin",
      "auth": {
        "personal_api_key": null,
        "access_token": null,
        "expires_at": null
      }
    },
    "apple_watch": {
      "kind": "apple_health_export",
      "archive": "~/Downloads/apple-health-export.zip"
    }
  },
  "merge": {
    "primary_source": "bike_meter",
    "min_overlap_ratio": 0.90,
    "streams": {
      "record.heart_rate": ["bike_meter", "health_band"],
      "session.total_calories": ["health_band"],
      "session.metabolic_calories": ["health_band"]
    }
  },
  "destinations": {
    "strava": {
      "kind": "strava",
      "client_id": null,
      "client_secret": null,
      "athlete_id": null,
      "access_token": null,
      "refresh_token": null,
      "expires_at": null
    }
  }
}
