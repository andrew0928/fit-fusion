{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FIT Fusion config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone", "output_dir", "sources", "merge"],
  "properties": {
    "version": {"const": 1},
    "timezone": {"$ref": "#/definitions/text"},
    "output_dir": {"$ref": "#/definitions/text"},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/sourceId"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/definitions/fitDirectory"},
          {"$ref": "#/definitions/garminConnect"},
          {"$ref": "#/definitions/appleHealthExport"},
          {
            "allOf": [
              {"$ref": "#/definitions/extensionConnector"},
              {"properties": {"kind": {"not": {"enum": ["fit_directory", "garmin_connect", "apple_health_export"]}}}}
            ]
          }
        ]
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "min_overlap_ratio"],
      "properties": {
        "primary_source": {"$ref": "#/definitions/sourceId"},
        "min_overlap_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "field_ids": {
          "type": "object",
          "propertyNames": {"pattern": "^record\\.[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 252}
        },
        "streams": {
          "type": "object",
          "default": {},
          "description": "Source priorities for fields to override or add. Unlisted fields inherit the primary FIT.",
          "propertyNames": {"pattern": "^(record\\.[a-z][a-z0-9_]*|session\\.(total_calories|metabolic_calories))$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/sourceId"}
          },
          "dependencies": {
            "record.position_lat": ["record.position_long"],
            "record.position_long": ["record.position_lat"]
          }
        }
      }
    },
    "destinations": {
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/identifier"},
      "properties": {
        "strava": {
          "if": {"required": ["kind"]},
          "then": {"$ref": "#/definitions/target"},
          "else": {"$ref": "#/definitions/strava"}
        }
      },
      "additionalProperties": {"$ref": "#/definitions/target"}
    }
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1},
    "optionalText": {"type": ["string", "null"], "minLength": 1},
    "expiresAt": {"type": ["integer", "null"], "minimum": 0},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "device": {
      "oneOf": [
        {"$ref": "#/definitions/identifier"},
        {"type": "object", "additionalProperties": false, "required": ["manufacturer", "product"],
         "properties": {
           "manufacturer": {"type": "integer", "minimum": 0, "maximum": 65534},
           "product": {"type": "integer", "minimum": 0, "maximum": 65534}
         }}
      ]
    },
    "sourceId": {"$ref": "#/definitions/identifier"},
    "extensionConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"$ref": "#/definitions/identifier"},
        "options": {"type": "object"}
      }
    },
    "fitDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "directory"],
      "properties": {
        "kind": {"const": "fit_directory"},
        "device": {"$ref": "#/definitions/device"},
        "directory": {"$ref": "#/definitions/text"}
      }
    },
    "garminConnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "device", "cache_dir", "auth"],
      "properties": {
        "kind": {"const": "garmin_connect"},
        "device": {"$ref": "#/definitions/device"},
        "cache_dir": {"$ref": "#/definitions/text"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personal_api_key": {"$ref": "#/definitions/optionalText"},
            "access_token": {"$ref": "#/definitions/optionalText"},
            "expires_at": {"$ref": "#/definitions/expiresAt"}
          }
        }
      }
    },
    "appleHealthExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "archive"],
      "properties": {
        "kind": {"const": "apple_health_export"},
        "archive": {"$ref": "#/definitions/text"}
      }
    },
    "target": {
      "type": "object",
      "required": ["kind"],
      "if": {"properties": {"kind": {"const": "strava"}}},
      "then": {"$ref": "#/definitions/strava"},
      "else": {"$ref": "#/definitions/extensionConnector"}
    },
    "strava": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "strava"},
        "client_id": {"$ref": "#/definitions/optionalText"},
        "client_secret": {"$ref": "#/definitions/optionalText"},
        "athlete_id": {"$ref": "#/definitions/optionalText"},
        "access_token": {"$ref": "#/definitions/optionalText"},
        "refresh_token": {"$ref": "#/definitions/optionalText"},
        "expires_at": {"$ref": "#/definitions/expiresAt"}
      }
    }
  }
}
