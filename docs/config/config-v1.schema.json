{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FIT Fusion config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone", "output_dir", "sources", "merge"],
  "properties": {
    "version": {"const": 1},
    "timezone": {"$ref": "#/definitions/text"},
    "output_dir": {"$ref": "#/definitions/text"},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/sourceId"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/definitions/fitDirectory"},
          {"$ref": "#/definitions/garminConnect"},
          {"$ref": "#/definitions/appleHealthExport"}
        ]
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "min_overlap_ratio", "streams"],
      "properties": {
        "primary_source": {"$ref": "#/definitions/sourceId"},
        "min_overlap_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "streams": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "record.heart_rate", "record.position_lat", "record.position_long",
              "record.speed", "record.enhanced_speed", "record.altitude", "record.enhanced_altitude",
              "record.distance", "record.cadence", "record.temperature", "record.power",
              "session.total_calories", "session.metabolic_calories"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/sourceId"}
          },
          "dependencies": {
            "record.position_lat": ["record.position_long"],
            "record.position_long": ["record.position_lat"]
          }
        }
      }
    },
    "destinations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"strava": {"$ref": "#/definitions/strava"}}
    }
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1},
    "optionalText": {"type": ["string", "null"], "minLength": 1},
    "expiresAt": {"type": ["integer", "null"], "minimum": 0},
    "sourceId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "fitDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "device", "directory"],
      "properties": {
        "kind": {"const": "fit_directory"},
        "device": {"enum": ["bryton_rider_460", "garmin_cirqa"]},
        "directory": {"$ref": "#/definitions/text"}
      }
    },
    "garminConnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "device", "cache_dir", "auth"],
      "properties": {
        "kind": {"const": "garmin_connect"},
        "device": {"const": "garmin_cirqa"},
        "cache_dir": {"$ref": "#/definitions/text"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personal_api_key": {"$ref": "#/definitions/optionalText"},
            "access_token": {"$ref": "#/definitions/optionalText"},
            "expires_at": {"$ref": "#/definitions/expiresAt"}
          }
        }
      }
    },
    "appleHealthExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "archive"],
      "properties": {
        "kind": {"const": "apple_health_export"},
        "archive": {"$ref": "#/definitions/text"}
      }
    },
    "strava": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {"$ref": "#/definitions/optionalText"},
        "client_secret": {"$ref": "#/definitions/optionalText"},
        "athlete_id": {"$ref": "#/definitions/optionalText"},
        "access_token": {"$ref": "#/definitions/optionalText"},
        "refresh_token": {"$ref": "#/definitions/optionalText"},
        "expires_at": {"$ref": "#/definitions/expiresAt"}
      }
    }
  }
}
